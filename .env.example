# ============================================================================
# Variables de entorno de ejemplo — NO requeridas: el backend actual es
# Firebase (assets/js/firebase-config.js). Documentan la alternativa futura
# PostgreSQL + PostGIS descrita en docs/ARQUITECTURA.md.
# Copia este archivo a .env y completa los valores.
# ============================================================================

# --- Base de datos PostgreSQL + PostGIS ---
DATABASE_URL=postgresql://usuario:password@localhost:5432/arbolado
PGSSLMODE=require

# --- Autenticación ---
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
SESSION_TTL=86400
# Roles: admin | gis | editor | consulta | publico

# --- Object Storage (fotografías de árboles e imágenes de especies) ---
STORAGE_ENDPOINT=https://s3.tu-region.amazonaws.com
STORAGE_BUCKET=arbolado-imagenes
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Procesamiento GIS en servidor (requiere GDAL/ogr2ogr instalados) ---
GDAL_BIN=/usr/bin
MAX_UPLOAD_MB=100

# --- Generación de imágenes botánicas por IA (capa opcional) ---
# Usa SIEMPRE el nombre científico como referencia; nunca una especie aleatoria.
AI_IMAGE_PROVIDER=            # p.ej. openai | stability | replicate
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=

# --- Mapa (opcional: proveedor de teselas con clave) ---
# Por defecto se usan teselas públicas (OSM/Esri/CARTO/OpenTopoMap) sin clave.
MAP_TILES_PROVIDER=osm
MAP_TILES_API_KEY=
