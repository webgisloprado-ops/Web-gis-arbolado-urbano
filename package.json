{
  "name": "web-gis-arbolado-urbano",
  "version": "1.1.0",
  "private": true,
  "description": "Web GIS de gestión, análisis y consulta ciudadana del arbolado urbano (Firebase + Vercel).",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "datos": "node scripts/generar-datos.mjs",
    "datos:custom": "node scripts/generar-datos.mjs",
    "imagenes": "node scripts/obtener-imagenes.mjs",
    "seed": "node scripts/seed-firestore.mjs",
    "deploy:rules": "firebase deploy --only firestore",
    "deploy:storage": "firebase deploy --only storage",
    "deploy:web": "vercel --prod"
  },
  "devDependencies": {
    "firebase-admin": "^12.0.0"
  },
  "keywords": ["gis", "webgis", "arbolado", "urban-forestry", "leaflet", "inventario", "firebase"],
  "license": "MIT",
  "engines": { "node": ">=18" }
}
